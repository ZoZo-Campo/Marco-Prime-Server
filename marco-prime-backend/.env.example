# ============================================================
# Marco Prime — configuration locale (tablette, poste de dev)
# ------------------------------------------------------------
# Pour le serveur de l'école, utilisez `.env.server.example` à la
# racine du dépôt : les identifiants MySQL restent sur l'hôte et le
# fichier n'est jamais modifiable depuis l'interface.
#
# 1. Copier ce fichier en `.env` :
#      cp .env.example .env
# 2. Remplacer les valeurs en MAJUSCULES (UTILISATEUR, MOT_DE_PASSE, ...).
# 3. Ne jamais committer le fichier `.env` : il contient des secrets.
#
# En mode local, le fichier `.env` peut aussi être importé depuis
# l'interface : Configuration > Installation > Importer un fichier .env
# (l'import remplace l'ancien fichier et crée une sauvegarde `.env.bak-...`).
# ============================================================

# Mode local : tablette Termux ou poste de développement.
# En mode `server`, l'édition du .env depuis l'interface est désactivée.
MARCO_DEPLOYMENT=local

# Port du serveur Marco. Garder 3001 sur la tablette.
API_PORT=3001

# Interface d'écoute. 127.0.0.1 sur la tablette ; 0.0.0.0 dans un conteneur.
API_HOST=127.0.0.1

# Laisser false sur la tablette : le serveur n'écoute que sur 127.0.0.1.
# Passer à true pour exiger un jeton, même en local.
API_AUTH_ENABLED=false

# Jeton interne, obligatoire uniquement si API_AUTH_ENABLED=true.
# Générer avec : openssl rand -hex 32
# Le frontend doit utiliser exactement la même valeur (VITE_API_TOKEN).
API_TOKEN=

# Base MySQL Fouaille, fournie par l'administratrice.
# Format : mysql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_DE_LA_BASE
# Encoder les caractères spéciaux du mot de passe (ex. @ -> %40).
DATABASE_URL="mysql://UTILISATEUR:MOT_DE_PASSE@HOTE:3307/NOM_DE_LA_BASE"

# production sert aussi le frontend ; development pour le rechargement à chaud.
NODE_ENV=production

# Origine autorisée pour le navigateur.
FRONTEND_URL=http://127.0.0.1:3001

# Chemin public de l'API, exposé par /runtime-config.js.
PUBLIC_API_URL=/api/v1

# Synchronisation Fouaille : laisser false sauf besoin explicite.
FOUAILLE_API_URL="https://fouaille.bde-tps.fr/api/product"
FOUAILLE_SYNC_ENABLED=false
FOUAILLE_SYNC_INTERVAL_MS=300000

# Dossier des données locales (catalogue, compta, prix d'achat, journal).
# Sur la tablette : ./data (par défaut). Dans Docker : /app/data.
# MARCO_DATA_DIR=./data

# Copiez ce fichier vers .env.server et remplacez chaque REPLACE_HERE.
MARCO_API_DOMAIN=REPLACE_HERE.example.fr
API_AUTH_ENABLED=true
API_TOKEN=REPLACE_HERE_LONG_RANDOM_TOKEN

# Cette valeur reste uniquement sur le serveur, jamais sur le Raspberry.
DATABASE_URL=mysql://REPLACE_HERE_USER:REPLACE_HERE_PASSWORD@REPLACE_HERE_HOST:3306/REPLACE_HERE_DATABASE

FOUAILLE_API_URL=https://fouaille.bde-tps.fr/api/product
FOUAILLE_SYNC_ENABLED=false
FOUAILLE_SYNC_INTERVAL_MS=300000
MARCO_DATA_DIR=/app/data
API_PORT=3000
NODE_ENV=production
TZ=Europe/Paris

# Origines autorisées, séparées par des virgules.
FRONTEND_URL=http://127.0.0.1:3001,http://localhost:3001


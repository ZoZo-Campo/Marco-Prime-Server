# Copiez ce fichier vers .env.server, puis remplacez chaque REPLACE_HERE.
# Ce fichier reste uniquement sur le serveur : il contient les identifiants MySQL.
# Il est ignoré par Git et ne doit jamais être copié sur un kiosque.

# ---------------------------------------------------------------------------
# Nom de domaine et HTTPS
# ---------------------------------------------------------------------------

# Nom exact servi par Caddy. Il doit résoudre vers l'adresse du serveur pour
# les postes qui utiliseront Marco.
MARCO_API_DOMAIN=REPLACE_HERE.example.fr

# Directive TLS complète, insérée telle quelle dans le Caddyfile.
#   tls internal                                -> autorité locale Caddy (réseau fermé)
#   tls votre-adresse@exemple.fr                -> Let's Encrypt (DNS public requis)
#   tls /certs/fullchain.pem /certs/privkey.pem -> certificat fourni par l'école
# Voir INSTALLATION_SERVEUR.md, section « Choisir le mode HTTPS ».
MARCO_TLS_DIRECTIVE=tls internal

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------

API_PORT=3000
API_HOST=0.0.0.0
MARCO_DEPLOYMENT=server

# Authentification par jeton. Générer avec : openssl rand -hex 32
# Le script `./server check` exige exactement 64 caractères hexadécimaux.
# Ce même jeton est injecté par Caddy vers l'API et signe les sessions
# administrateur de 30 minutes : il ne doit jamais être communiqué aux
# utilisateurs, et le changer invalide les sessions en cours.
API_AUTH_ENABLED=true
API_TOKEN=REPLACE_HERE_LONG_RANDOM_TOKEN

# Facultatif : exiger la session administrateur aussi en mode local.
# En mode serveur, elle est toujours exigée dès qu'un mot de passe existe.
# MARCO_ADMIN_AUTH=required

# Origines autorisées pour le navigateur. En déploiement intégré, le frontend
# et l'API partagent la même origine : une seule valeur suffit.
FRONTEND_URL=https://REPLACE_HERE.example.fr

# Chemin public de l'API, lu par /runtime-config.js.
PUBLIC_API_URL=/api/v1

# ---------------------------------------------------------------------------
# Base de données et Fouaille
# ---------------------------------------------------------------------------

# Cette valeur reste uniquement sur le serveur, jamais sur un kiosque.
# Encoder les caractères spéciaux du mot de passe (ex. @ -> %40).
# Le port est celui fourni par l'administrateur Fouaille (3306 par défaut).
DATABASE_URL=mysql://REPLACE_HERE_USER:REPLACE_HERE_PASSWORD@REPLACE_HERE_HOST:3306/REPLACE_HERE_DATABASE

FOUAILLE_API_URL=https://fouaille.example.fr/api/product
FOUAILLE_SYNC_ENABLED=false
FOUAILLE_SYNC_INTERVAL_MS=300000

# ---------------------------------------------------------------------------
# Exécution
# ---------------------------------------------------------------------------

# Volume Docker : sélection du catalogue, prix d'achat, compta, journal.
MARCO_DATA_DIR=/app/data
NODE_ENV=production
TZ=Europe/Paris

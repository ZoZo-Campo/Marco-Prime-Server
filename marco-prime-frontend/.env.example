# Developpement local uniquement.
# Sur la tablette, ne pas creer ce fichier : le build utilise /api/v1 en relatif.
VITE_API_URL=http://localhost:3000/api/v1

# Doit correspondre a API_TOKEN du backend si API_AUTH_ENABLED=true.
# Ne jamais mettre les identifiants MySQL/Fouaille dans ce fichier.
VITE_API_TOKEN=

# Kiosque séparé uniquement (Raspberry, mini-PC).
# Si le frontend est servi par le serveur de l'école (mode recommandé), ce
# fichier et compose.frontend.yml ne servent pas.

# Adresse HTTPS publique, avec /api/v1.
MARCO_REMOTE_API_URL=https://REPLACE_HERE.example.fr/api/v1

# Strictement identique à API_TOKEN dans .env.server.
MARCO_API_TOKEN=REPLACE_HERE_LONG_RANDOM_TOKEN

# Port local du kiosque, sur 127.0.0.1 seulement.
MARCO_FRONTEND_PORT=3001
